# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# Файл .env в репозиторий не попадает — он в .gitignore.

# --- обязательное ---

# Токен бота от @BotFather
BOT_TOKEN=

DATABASE_URL=postgres://chekmate:chekmate@localhost:5432/chekmate?sslmode=disable

# --- состав чека ---

# Ключ сервиса, который отдаёт позиции чека по его фискальным реквизитам.
# Без ключа бот работает, но видит только сумму и дату из QR-кода —
# то есть примерно то же, что показывает банк.
#
# Где взять: зарегистрируйтесь на proverkacheka.com и возьмите
# api key-token в личном кабинете, раздел "Помощь".
RECEIPT_API_TOKEN=

# Адрес сервиса. Менять нужно, только если используется другой совместимый
# источник или тестовый сервер.
RECEIPT_API_URL=https://proverkacheka.com/api/v1/check/get

# --- сеть ---

# Нужен там, где api.telegram.org недоступен напрямую.
# Поддерживаются http://, https:// и socks5://, с логином и паролем:
#   TELEGRAM_PROXY=socks5://user:pass@1.2.3.4:1080
TELEGRAM_PROXY=

# --- необязательное ---

TIMEZONE=Europe/Moscow
LOG_LEVEL=info
HTTP_ADDR=:8080
